  "files": [
    "dist"
  ],
  "scripts": {
    "build": "NODE_OPTIONS='--max-old-space-size=4096' tsup",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "biome check src",
    "lint:fix": "biome check --write src",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run lint && npm run test",
    "bench": "vitest bench --run",
    "create:adapter": "node scripts/create-adapter.mjs",
    "changeset": "changeset",
    "changeset:publish": "node -e 'if (process.env.NPM_TOKEN) { require(\"child_process\").execSync(\"npm publish --access public\", { stdio: \"inherit\" }); } else { console.log(\"NPM_TOKEN secret not present, skipping registry publish\"); }'"
  },
  "keywords": [
    "kv",
    "key-value",
    "cache",
    "storage",
    "adapter",
    "memory",
    "redis"
  ],
  "author": "zisam shaikh <zisamshaikh7@gmail.com>",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@changesets/cli": "^2.27.12",
    "tsup": "^8.3.6",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
